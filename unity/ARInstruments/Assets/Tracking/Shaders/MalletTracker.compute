#pragma kernel CSMain

// 手机摄像头的输入画面
Texture2D<float4> InputTexture;

// 左右手 HSV 阈值 (注意：在 HLSL 中，H, S, V 的范围都是 0.0 ~ 1.0)
float3 LeftLowerHSV;
float3 LeftUpperHSV;
float3 RightLowerHSV;
float3 RightUpperHSV;

// 方向归一化参数：先应用 VerticallyMirrored，再应用 ClockwiseRotation (0/90/180/270)
int ClockwiseRotation;
int VerticallyMirrored;

// 显存数据输出通道
// [0]=左手X坐标和, [1]=左手Y坐标和, [2]=左手面积像素数
// [3]=右手X坐标和, [4]=右手Y坐标和, [5]=右手面积像素数
RWStructuredBuffer<uint> ResultBuffer;

groupshared uint gs_Accum[6];

// RGB 转 HSV 的核心算法 (GPU 极速版)
float3 RGBtoHSV(float3 c)
{
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = c.g < c.b ? float4(c.bg, K.wz) : float4(c.gb, K.xy);
    float4 q = c.r < p.x ? float4(p.xyw, c.r) : float4(c.r, p.yzx);
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

bool MatchHSV(float3 hsv, float3 lower, float3 upper)
{
    bool hueMatch = (lower.x <= upper.x)
        ? (hsv.x >= lower.x && hsv.x <= upper.x)
        : (hsv.x >= lower.x || hsv.x <= upper.x);
    return hueMatch &&
           hsv.y >= lower.y && hsv.y <= upper.y &&
           hsv.z >= lower.z && hsv.z <= upper.z;
}

uint2 NormalizePixelCoordinates(uint2 rawCoord, uint width, uint height)
{
    uint y1 = (VerticallyMirrored != 0) ? (height - 1u - rawCoord.y) : rawCoord.y;
    int rot = ((ClockwiseRotation % 360) + 360) % 360;
    if (rot == 90)
    {
        return uint2(y1, rawCoord.x);
    }
    if (rot == 180)
    {
        return uint2(width - 1u - rawCoord.x, y1);
    }
    if (rot == 270)
    {
        return uint2(height - 1u - y1, width - 1u - rawCoord.x);
    }
    return uint2(rawCoord.x, height - 1u - y1);
}

// 8x8 线程组，每次并发处理 64 个像素
[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    if (groupIndex < 6)
    {
        gs_Accum[groupIndex] = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    uint width;
    uint height;
    InputTexture.GetDimensions(width, height);

    if (id.x < width && id.y < height)
    {
        float4 color = InputTexture[id.xy];
        float3 hsv = RGBtoHSV(color.rgb);
        bool leftMatch = MatchHSV(hsv, LeftLowerHSV, LeftUpperHSV);
        bool rightMatch = MatchHSV(hsv, RightLowerHSV, RightUpperHSV);

        if (leftMatch || rightMatch)
        {
            uint2 oriented = NormalizePixelCoordinates(id.xy, width, height);

            if (leftMatch)
            {
                InterlockedAdd(gs_Accum[0], oriented.x);
                InterlockedAdd(gs_Accum[1], oriented.y);
                InterlockedAdd(gs_Accum[2], 1);
            }

            if (rightMatch)
            {
                InterlockedAdd(gs_Accum[3], oriented.x);
                InterlockedAdd(gs_Accum[4], oriented.y);
                InterlockedAdd(gs_Accum[5], 1);
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    if (groupIndex < 6 && gs_Accum[groupIndex] > 0)
    {
        InterlockedAdd(ResultBuffer[groupIndex], gs_Accum[groupIndex]);
    }
}
